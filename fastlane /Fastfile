default_platform(:android)

platform :android do
  desc "Upload first AAB from build_output to alpha using GOOGLE_PLAY_JSON_KEY and PACKAGE_NAME"
  lane :upload_to_alpha do
    aab_path = Dir["build_output/*.aab"].first
    if aab_path.nil?
      UI.user_error!("No AAB found in build_output. Make sure the download step succeeded.")
    end

    supply(
      aab: aab_path,
      track: "alpha",
      package_name: ENV["PACKAGE_NAME"],
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"]
    )
  end
end
